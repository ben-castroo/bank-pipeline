# --- Base de datos (Postgres / Supabase) ---
# Reutiliza la misma cadena del ETL (pooler puerto 6543, sslmode=require)
SUPABASE_DB_URL=postgresql+psycopg2://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# --- Supabase Storage (artefacto del modelo) ---
SUPABASE_PROJECT_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...
MODEL_BUCKET=models
MODEL_PREFIX=deposit

# --- Autenticación del API ---
API_KEY=pon-aqui-un-token-secreto

# --- Parámetros ---
DEFAULT_THRESHOLD=0.5
RETRAIN_SAMPLE_SIZE=5000
# CLEAN_ID_COLUMN=id   # descomenta y ajusta si bank_clean usa otra columna id
